# Copier ce fichier en .env et renseigner les valeurs (le .env n'est pas versionné)

PORT=3000
NODE_ENV=development

# Base MySQL (LWS)
DB_DIALECT=mysql
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
# true uniquement si l'hébergeur exige SSL
DB_SSL=false

# Générer avec : node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
